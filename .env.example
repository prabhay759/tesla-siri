# ══════════════════════════════════════════════════════════════════════════════
#  Tesla Siri Server — environment template
#  Copy this file to .env and fill in your values.
#  NEVER commit .env — it contains secrets.
# ══════════════════════════════════════════════════════════════════════════════

# ── Tesla OAuth app credentials ───────────────────────────────────────────────
# Create your app at https://developer.tesla.com
TESLA_CLIENT_ID=your-client-id-here
TESLA_CLIENT_SECRET=ta-secret.your-secret-here

# ── Your vehicle ──────────────────────────────────────────────────────────────
# Find VIN: Tesla touchscreen → Controls → Software → Additional Vehicle Info
TESLA_VIN=YOUR_VIN_HERE

# ── Tokens (auto-managed — set these after running the auth flow) ─────────────
# Run:  node get-tesla-token.mjs   →   node exchange-code.mjs <code>
# The token manager uses TESLA_REFRESH_TOKEN to get a fresh access token on startup.
# On Railway: set TESLA_REFRESH_TOKEN as a Railway environment variable.
TESLA_ACCESS_TOKEN=
TESLA_REFRESH_TOKEN=
TESLA_TOKEN_EXPIRES_AT=

# ── OAuth redirect URI (must match your Tesla developer app settings) ──────────
# Local dev: http://localhost:5431/mcp
# Production: leave as default unless you changed it in Tesla developer portal
TESLA_REDIRECT_URI=http://localhost:5431/mcp

# ── Addresses (used in voice commands: "go home", "drive to work") ────────────
HOME_ADDRESS=Your Home Address, City, Country
WORK_ADDRESS=Your Work Address, City, Country

# ── Server ports ──────────────────────────────────────────────────────────────
MCP_MODE=stdio
MCP_PORT=3001
PORT=3000

# ── Siri endpoint security (optional but recommended) ─────────────────────────
# Set any random string here, then add ?secret=<value> to your Siri Shortcut URL
SIRI_SECRET=

# ── Groq AI (free — powers natural language commands) ─────────────────────────
# Get your free key at: https://console.groq.com
# Models used: llama-3.3-70b-versatile → llama-3.1-8b-instant → mixtral-8x7b-32768
GROQ_API_KEY=your-groq-api-key-here

# ── Contacts for automatic messaging ─────────────────────────────────────────
# Add one line per contact. Name must match what you say in voice commands.
# Use phone number (+41791234567) or iMessage name/email for iOS Send Message.
# Example: CONTACT_MOM=+41791234567
CONTACT_USER=John

# ── Public URL (set after deploying to Railway) ────────────────────────────────
# Used when registering with Tesla: node get-tesla-token.mjs your-app.railway.app
PUBLIC_URL=https://your-app.railway.app

# ── Tesla public key ─────────────────────────────────────────────────────────
# For Railway: paste the full contents of tesla-public.pem here (including header/footer lines).
# The server serves this at /.well-known/appspecific/com.tesla.3p.public-key.pem
# For local dev: leave this blank and keep tesla-public.pem in the project root.
TESLA_PUBLIC_KEY=
# Local dev fallback (ignored if TESLA_PUBLIC_KEY is set):
TESLA_PUBLIC_KEY_FILE=tesla-public.pem
